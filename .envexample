#Prefijo
prefix=!
#Numero del propietario (Codigo de pais + Numero). Ejemplo: 5215512345678
owner=
#Canal de anuncios (URL del canal de WhatsApp, opcional)
channel=
#Telegram token (se obtiene en https://core.telegram.org/bots#6-botfather)
token=
#Puerto sobre el que la apicacion se mostrara
port=4000
#Numero del bot (Codigo de pais + Numero, sin + ni espacios)
bot=
#Ejecutable de python
py_cmd_img=
py_cmd_vid=
py_cmd_gif=
py_cmd_pic=
#Ruta al ejecutable ffmpeg (opcional, si no está en PATH)
FFMPEG_PATH=
#Configuracion de Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CONTEXT_LIMIT=20
#Identificadores que activan menu en grupos junto a menu/comandos (separados por coma)
BOT_MENU_IDENTIFIERS=bot,chip,4ktbot
#Instruccion base del bot.
OLLAMA_SYSTEM_PROMPT=Eres 4ktbot, un asistente util y claro. Responde en espanol de forma breve y con buen contexto del chat actual.
